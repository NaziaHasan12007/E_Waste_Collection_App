<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ewaste.client.controller.admin.CollectorManagementController"
            prefHeight="740.0" prefWidth="1100.0" stylesheets="@../../css/admin.css">

    <!-- Top Action Bar -->
    <top>
        <HBox spacing="18.0" alignment="CENTER_LEFT" styleClass="card-top-bar">
            <Button fx:id="backButton" text="← Dashboard" onAction="#handleBack" styleClass="button-secondary"/>
            <VBox spacing="2.0">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Collector Fleet Administration" styleClass="heading-1"/>
                    <Label text="LOGISTICS_OPS" styleClass="badge-tag"/>
                </HBox>
                <Label text="Monitor active fleet personnel, operational zones, vehicle payloads, and online availability" styleClass="subtext"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton" text="Refresh Fleet" onAction="#handleRefresh" styleClass="button"/>
            <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="26.0" prefHeight="26.0"/>
        </HBox>
    </top>

    <!-- Center Workspace -->
    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="22.0" right="28.0" bottom="22.0" left="28.0"/>
            </padding>

            <!-- Table View -->
            <TableView fx:id="collectorsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="Collector ID" prefWidth="95.0"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="150.0"/>
                    <TableColumn fx:id="vehicleColumn" text="Vehicle Type" prefWidth="110.0"/>
                    <TableColumn fx:id="availableColumn" text="Active / Ready" prefWidth="110.0"/>
                    <TableColumn fx:id="workloadColumn" text="Current Assigned (kg)" prefWidth="145.0"/>
                    <TableColumn fx:id="maxCapacityColumn" text="Total Capacity (kg)" prefWidth="135.0"/>
                </columns>
                <placeholder>
                    <Label text="No registered collectors found in database records." styleClass="subtext"/>
                </placeholder>
            </TableView>

            <!-- Quick Action Console -->
            <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="card">
                <VBox spacing="2.0">
                    <Label text="Availability Status Control" styleClass="heading-2"/>
                    <Label text="Toggle selected collector between Active duty and Inactive reserve" styleClass="subtext"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="toggleAvailabilityButton" text="Toggle Availability Status"
                        onAction="#handleToggleAvailability" styleClass="button" disable="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>