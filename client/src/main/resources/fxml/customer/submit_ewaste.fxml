<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ewaste.client.controller.customer.SubmitEWasteController"
            styleClass="root" prefWidth="800" prefHeight="600"
            stylesheets="@../../css/admin.css">

    <top>
        <VBox styleClass="card-top-bar" spacing="10">
            <padding>
                <Insets top="16" right="30" bottom="16" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Back" styleClass="button-secondary" onAction="#handleBack"/>
                <Text text="Submit E-Waste" styleClass="heading-1"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Text text="♻️" styleClass="heading-1"/>
            </HBox>

            <Text text="Help us recycle electronic waste responsibly" styleClass="subtext"/>
        </VBox>
    </top>

    <center>
        <ScrollPane styleClass="root" fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="16" styleClass="root" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20" right="30" bottom="20" left="30"/>
                    </padding>

                    <!-- Error Label -->
                    <Label fx:id="lblError" styleClass="badge-tag" visible="false" text=""
                           textFill="#ef4444" wrapText="true"/>

                    <!-- Item Name -->
                    <VBox spacing="6">
                        <Label text="Item Name" styleClass="subtext" textFill="#e2e8f0"/>
                        <TextField fx:id="txtItemName" promptText="e.g., Laptop, Mobile Phone" styleClass="text-field"/>
                    </VBox>

                    <!-- Category -->
                    <VBox spacing="6">
                        <Label text="Category" styleClass="subtext" textFill="#e2e8f0"/>
                        <ComboBox fx:id="cmbCategory" styleClass="text-field category-dropdown pickup-dropdown" promptText="Select category"/>
                    </VBox>

                    <!-- Weight & Quantity -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Weight (kg)" styleClass="subtext" textFill="#e2e8f0"/>
                            <TextField fx:id="txtWeight" promptText="e.g., 2.5" styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Quantity" styleClass="subtext" textFill="#e2e8f0"/>
                            <TextField fx:id="txtQuantity" promptText="e.g., 1" styleClass="text-field"/>
                        </VBox>
                    </HBox>

                    <!-- Condition -->
                    <VBox spacing="6">
                        <Label text="Condition" styleClass="subtext" textFill="#e2e8f0"/>
                        <ComboBox fx:id="cmbCondition" styleClass="text-field pickup-dropdown" promptText="Select condition">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="WORKING"/>
                                    <String fx:value="MINOR_DAMAGE"/>
                                    <String fx:value="MAJOR_DAMAGE"/>
                                    <String fx:value="NON_FUNCTIONAL"/>
                                    <String fx:value="SCRAP_ONLY"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="6">
                        <Label text="Description (Optional)" styleClass="subtext" textFill="#e2e8f0"/>
                        <TextArea fx:id="txtDescription" promptText="Any additional details about the item..."
                                  styleClass="text-field" prefHeight="80" wrapText="true"/>
                    </VBox>

                    <CheckBox fx:id="chkHazardous" text="This item may contain hazardous materials"
                              styleClass="check-box"/>

                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Pickup Address" styleClass="subtext"/>
                            <TextField fx:id="txtAddress" promptText="Enter the collection address"
                                       styleClass="text-field"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Preferred Date" styleClass="subtext"/>
                            <DatePicker fx:id="dpkPreferredDate" styleClass="text-field"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Preferred Time" styleClass="subtext"/>
                            <ComboBox fx:id="cmbPreferredTime" styleClass="text-field pickup-dropdown"
                                      promptText="Select a time"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="8" styleClass="card">
                        <Label text="Items in this pickup" styleClass="heading-2"/>
                        <ListView fx:id="listItems" prefHeight="110" styleClass="table-view"/>
                        <HBox spacing="20">
                            <Label text="Items:" styleClass="subtext"/>
                            <Label fx:id="lblItemCount" text="0" styleClass="metric-value-accent"/>
                            <Label text="Total weight:" styleClass="subtext"/>
                            <Label fx:id="lblTotalWeight" text="0.00 kg" styleClass="metric-value"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRemoveItem" text="Remove Selected"
                                    styleClass="button-secondary" onAction="#handleRemoveItem"/>
                            <Button fx:id="btnClearAll" text="Clear All"
                                    styleClass="button-secondary" onAction="#handleClearAll"/>
                        </HBox>
                    </VBox>

                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnAddItem" text="Add Item" styleClass="button"
                                prefWidth="150" onAction="#handleAddItem"/>
                    </HBox>

                    <!-- Estimated Points -->
                    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="card">
                        <Label text="Estimated Points:" styleClass="heading-2"/>
                        <Label fx:id="lblEstimatedPoints" text="0" styleClass="metric-value"/>
                    </HBox>

                    <!-- Submit Button -->
                    <HBox spacing="15" alignment="CENTER">
                        <Button fx:id="btnSubmit" text="Submit" styleClass="button-success" prefHeight="44" prefWidth="200"
                                onAction="#handleSubmit"/>
                        <Button fx:id="btnCancel" text="Back" styleClass="button-secondary" prefHeight="44" prefWidth="100"
                                onAction="#handleBack"/>
                        <Button text="Clear" styleClass="button-secondary" prefHeight="44" prefWidth="100"
                                onAction="#handleClear"/>
                    </HBox>

                    <!-- Progress Indicator -->
                    <ProgressIndicator fx:id="progressIndicator" visible="false" styleClass="progress-indicator"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>