<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ewaste.client.controller.RegisterController"
      alignment="CENTER" spacing="14" styleClass="root" prefWidth="440" prefHeight="650"
      stylesheets="@../../css/admin.css">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="4">
        <Text text="♻️" style="-fx-font-size: 48px;" styleClass="heading-1"/>
        <Text text="Create Account" styleClass="heading-1"/>
        <Text text="Join us in making a difference" styleClass="subtext"/>
    </VBox>

    <!-- Error Label -->
    <Label fx:id="lblError" styleClass="badge-tag" visible="false" text=""
           textFill="#ef4444" wrapText="true" maxWidth="400"/>

    <!-- Full Name -->
    <VBox spacing="4" maxWidth="400">
        <Label text="Full Name" styleClass="subtext" textFill="#94a3b8"/>
        <TextField fx:id="txtFullName" promptText="Enter your full name" styleClass="text-field" prefHeight="40"/>
    </VBox>

    <!-- Email -->
    <VBox spacing="4" maxWidth="400">
        <Label text="Email Address" styleClass="subtext" textFill="#94a3b8"/>
        <TextField fx:id="txtEmail" promptText="Enter your email" styleClass="text-field" prefHeight="40"/>
    </VBox>

    <!-- Password -->
    <VBox spacing="4" maxWidth="400">
        <Label text="Password" styleClass="subtext" textFill="#94a3b8"/>
        <PasswordField fx:id="txtPassword" promptText="Create a password (min 6 characters)" styleClass="text-field" prefHeight="40"/>
    </VBox>

    <!-- Confirm Password -->
    <VBox spacing="4" maxWidth="400">
        <Label text="Confirm Password" styleClass="subtext" textFill="#94a3b8"/>
        <PasswordField fx:id="txtConfirmPassword" promptText="Confirm your password" styleClass="text-field" prefHeight="40"/>
    </VBox>

    <!-- Role Selection -->
    <VBox spacing="4" maxWidth="400">
        <Label text="Register as" styleClass="subtext" textFill="#94a3b8"/>
        <ComboBox fx:id="cmbRole" styleClass="text-field" prefHeight="40" promptText="Select role"/>
    </VBox>

    <!-- Collector Fields (Hidden by default) -->
    <VBox fx:id="collectorFields" spacing="4" maxWidth="400" visible="false" managed="false">
        <Label text="Vehicle Type" styleClass="subtext" textFill="#94a3b8"/>
        <TextField fx:id="txtVehicleType" promptText="e.g., Van, Truck" styleClass="text-field" prefHeight="40"/>

        <Label text="Max Capacity (kg)" styleClass="subtext" textFill="#94a3b8">
            <VBox.margin>
                <Insets top="4"/>
            </VBox.margin>
        </Label>
        <TextField fx:id="txtMaxCapacity" promptText="e.g., 500" styleClass="text-field" prefHeight="40"/>
    </VBox>

    <!-- Register Button -->
    <Button fx:id="btnRegister" text="Create Account" styleClass="button-success" maxWidth="400" prefHeight="44">
        <VBox.margin>
            <Insets top="10"/>
        </VBox.margin>
    </Button>

    <!-- Login Link -->
    <HBox alignment="CENTER" spacing="6" maxWidth="400">
        <Text text="Already have an account?" styleClass="subtext"/>
        <Button fx:id="btnLogin" text="Sign In" styleClass="button-secondary"/>
    </HBox>

    <!-- Progress Indicator -->
    <ProgressIndicator fx:id="progressIndicator" visible="false" styleClass="progress-indicator"/>

</VBox>